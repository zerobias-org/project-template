{
  "name": "@zerobias-org/{ARTIFACT_TYPE}-{vendor}-{suite}-{version}",
  "version": "1.0.0-rc.0",
  "description": "{name}",
  "author": "team@zerobias.com",
  "license": "ISC",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/{REPO_NAME}.git",
    "directory": "package/{vendor}/{suite}/{version}/"
  },
  "scripts": {
    "correct:deps": "tsx ../../../../scripts/correctDeps.ts",
    "validate": "tsx ../../../../scripts/validate.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "files": [
    "index.yml"
  ],
  "zerobias": {
    "dataloader-version": "1.0.0",
    "import-artifact": "{ARTIFACT_TYPE}",
    "package": "{vendor}.{suite}.{version}.{ARTIFACT_TYPE}"
  },
  "dependencies": {
    "@zerobias-org/suite-{vendor}-{suite}": "latest"
  }
}
