{
  "name": "@zerobias-org/project-template-zerobias-product_release",
  "version": "1.0.0",
  "description": "ZeroBias Product release project template artifact",
  "author": "team@zerobias.com",
  "license": "ISC",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git@github.com:zerobias-org/project-template.git",
    "directory": "package/zerobias/product_release"
  },
  "publishConfig": {
    "registry": "https://pkg.zerobias.org"
  },
  "files": [
    "*.yml",
    "files/**",
    "README.md",
    "npm-shrinkwrap.json"
  ],
  "zerobias": {
    "package": "zerobias.product_release.project_template",
    "dataloader-version": "1.0.0",
    "import-artifact": "project_template",
    "catalog-files": [
      "files/**"
    ],
    "documentation": "README.md"
  },
  "dependencies": {}
}
